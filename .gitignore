# ========== IDE 配置文件（本地开发工具配置，不提交） ==========
.idea/          # IntelliJ IDEA 配置
.vscode/        # VS Code 配置
*.iml           # IDEA 模块文件
*.suo           # Visual Studio 配置
*.user          # Visual Studio 用户配置
.classpath      # Eclipse 配置
.project        # Eclipse 配置
.settings/      # Eclipse 配置

# ========== 前端项目（Node.js/Vue/React 等） ==========
# 依赖目录
node_modules/
# 构建产物
dist/
build/
# 包管理日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# 环境变量文件（若包含敏感信息，需忽略；若为通用配置可保留）
.env.local
.env.*.local

# ========== 后端项目（Java/Maven/Gradle） ==========
# 编译产物
target/
# 依赖缓存
.m2/

# ========== 系统自动生成文件（各系统通用） ==========
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
# macOS
.DS_Store
# Linux
*.swp
*.swo

# ========== 临时/日志文件 ==========
*.tmp
*.temp
*.log
*.errlog